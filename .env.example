# Dataset root directory containing manifest.csv and .npy feature files
# Keep the 10+ GB dataset outside this repository, for example:
# DATASET_ROOT=D:/datasets/mimii-pump-precomputed
DATASET_ROOT=.

# Directory for pipeline outputs (checkpoints, predictions, reports)
OUTPUT_DIR=./artifacts

# Optional: Path to existing checkpoint file
CHECKPOINT_PATH=./artifacts/spec_only_checkpoint.pt

# Groq API key for diagnostic report generation (Stage 4)
# Leave empty to skip LLM report generation
GROQ_API_KEY=

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
